# 실제 장치에서는 ls -l /dev/serial/by-id/ 결과의 고정 경로를 권장합니다.
OGTECH_STM32_PORT=/dev/ttyACM0
OGTECH_STM32_BAUD=115200

# 한국 고정 시연값입니다. 다른 시간대에서는 시스템 시간대를 바꾸거나 이 값을 수정합니다.
OGTECH_UTC_OFFSET_MIN=540

# 아래 세 값은 현장 실측 전 추정값입니다.
OGTECH_TRAIL_THRESHOLD_M=30
OGTECH_RETURN_SPEED_MPS=0.8
OGTECH_RETURN_MARGIN_MIN=30
